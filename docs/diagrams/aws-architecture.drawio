        </mxCell>

        <!-- Deploy path -->
        <mxCell id="e-gh-ecr" value="1. push image" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=default;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="github" target="ecr">

        <!-- App calls AWS services with the EC2 instance role (no keys on the server) -->
        <mxCell id="e-ec2-s3" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#7AA116;exitX=0.536;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="ec2" target="s3">

@startuml component
' UML component diagram of the backend modules (com.campus.<module>).
' Every "requires" arrow comes from a real import on main (545e334, 28 Nov 2026).
' Verified via cross-module import grep in documentation/Necula_Matei/74-template-blueprint-report-runbook.md.
' Render from the repo root: java -jar plantuml.jar -tpng docs/diagrams/component.puml

title Campus Equipment & Incident Hub: UML component diagram\n(backend modules, state of main at 545e334, 28 Nov 2026)

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam nodesep 45
skinparam ranksep 60
skinparam ArrowColor #3B5B8C
skinparam component {
  BackgroundColor #F2F6FC
  BorderColor #3B5B8C
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #3B5B8C
}
skinparam package {
  BorderColor #8899AA
  BackgroundColor #FCFCFD
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #8899AA
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C8B560
}

component "React SPA\n(frontend/, React + Vite + TypeScript,\n20 pages + LiveToasts SSE client)" as spa

interface "REST API /api/v1/**\n+ SSE /api/v1/live/stream" as rest

package "Spring Boot 4.1 application  (backend/, base package com.campus)" as app {
  component "config\n(SecurityConfig, SecurityErrorHandler,\nOpenApiConfig, AsyncConfig,\nAwsConfig, SpaConfig)" as config <<module>>

  component "project (#140)\n(bilingual RO/EN search,\n10 kits, Reserve all)" as project <<module>>

  component "reassignment\n(Strategy engine +\nMaintenanceImpactSimulator)" as reassignment <<module>>

  component "incident\n(triage, photo upload #210,\nReliabilityCalculator #291)" as incident <<module>>

  interface "AssetDamagedEvent" as AssetDamagedEvent <<event>>
  interface "AssetRetiredEvent" as AssetRetiredEvent <<event>>
  interface "UserDisabledEvent" as UserDisabledEvent <<event>>

  component "reservation\n(bookings, bundles, holds, transfers,\nidempotency, .ics feed, next-free-slots)" as reservation <<module>>
  interface "ReservationApi" as ReservationApi

  component "catalog\n(categories, lab rooms, assets,\nretire + lockForBooking)" as catalog <<module>>
  interface "CatalogApi" as CatalogApi

  component "notification\n(dev log / prod SES +\nLiveStreams SSE #317/#332/#340)" as notification <<module>>
  interface "NotificationService" as NotificationService

  component "storage\n(Local / S3 + StorageValidation)" as storage <<module>>
  interface "StorageService" as StorageService

  component "user\n(auth/JWT, user/admin #206/#302,\nPickupPassService #283/#318)" as user <<module>>
  interface "UserApi" as UserApi

  component "common" as common <<module>> {
    component "audit" as caudit
    component "security" as csecurity
    component "time" as ctime
    component "error" as cerror
    component "paging" as cpaging
  }
  interface "AuditService" as AuditService
}

database "PostgreSQL 18\n(12 tables, 18 Flyway migrations)" as pg <<external>>
component "Amazon SES" as ses <<external>>
component "Amazon S3" as s3 <<external>>

' ---- client ----
spa ..> rest : HTTPS + JSON (Bearer JWT)\n+ SSE text/event-stream
rest -down- app

' ---- Observer events ----
incident -- AssetDamagedEvent : publishes
catalog -- AssetRetiredEvent : publishes (#280)
user -- UserDisabledEvent : publishes (#302)

reassignment ..> AssetDamagedEvent : <<listens>>\nAFTER_COMMIT, @Async
reassignment ..> AssetRetiredEvent : <<listens>>\nAFTER_COMMIT, @Async (#311)
reservation ..> UserDisabledEvent : <<listens>>\nAFTER_COMMIT, REQUIRES_NEW (#330)
notification ..> UserDisabledEvent : <<listens>>\nAFTER_COMMIT, close SSE (#340)

' ---- provided interfaces (each module's api package) ----
reservation -up- ReservationApi
catalog -up- CatalogApi
notification -up- NotificationService
storage -up- StorageService
user -up- UserApi
caudit -up- AuditService

' ---- required interfaces (exact cross-module imports on main) ----
project ..> CatalogApi
project ..> ReservationApi : bookBundle / isAssetFree
reassignment ..> ReservationApi
reassignment ..> CatalogApi
reassignment ..> NotificationService
incident ..> CatalogApi
incident ..> ReservationApi : usedMinutesByAsset (#298)
incident ..> StorageService : photos (#210)
incident ..> AuditService
reservation ..> CatalogApi
reservation ..> NotificationService
reservation ..> UserApi : findActiveRole (#310) + seeder
reservation ..> AuditService
catalog ..> AuditService
user ..> AuditService : pickup pass + user admin
notification ..> UserApi : prod SES + SSE active check
notification ..> config : AsyncConfig.MAIL_EXECUTOR (#366)
config ..> UserApi : findActiveRole (#117/#312)

' ---- external systems ----
app ..> pg : JDBC (Spring Data JPA, Flyway)
notification ..> ses : prod (campus-ses- pool)
storage ..> s3 : prod

note top of reassignment
  <b>Strategy</b>: ReassignmentBookingProcessor
  tries SubstituteStrategy in @Order:
  1. SameModelStrategy (same lab room first)
  2. SameCategoryStrategy (same lab room first)
  none free -> ReservationApi.forceCancel.
  Also runs dry-run MaintenanceImpactSimulator (#351).
  No api package: leaf module.
end note

note right of project
  <b>Leaf module (#140)</b>: no DB tables, no api.
  Loads 10 bilingual RO/EN JSON kits at startup;
  atomic "Reserve all" calls ReservationApi.bookBundle.
end note

note bottom of UserDisabledEvent
  <b>Observer (#302/#330/#335/#340)</b>:
  UserDisabledEvent listeners are synchronous
  AFTER_COMMIT (not @Async): reservation cancels
  upcoming CONFIRMED bookings in REQUIRES_NEW,
  and notification drops open LiveStreams SSE tabs.
end note

note right of notification
  <b>Live notifications (#290)</b>:
  GET /api/v1/live/stream (LiveStreams, 20 s :hb
  on 3-thread campus-sched- pool #347, max 5/user).
  dev: LoggingNotificationService -> LiveStreams
  prod: SesNotificationService -> LiveStreams + SES (#332)
end note

note right of storage
  Used by incident for photos (#210).
  dev: LocalStorageService -> uploads/
  prod: S3StorageService -> private S3 bucket
end note

legend right
  <b>Module rules</b> (AGENTS.md §5), enforced by 28 ArchUnit @ArchTest rules
  in backend/src/test/java/com/campus/architecture/:
  * other modules may import only a module's <b>api</b> package (+ common, config);
  * no default methods on ..api.. interfaces (#336);
  * catalog must not use reservation, incident, reassignment, project;
  * reservation must not use incident, reassignment, project;
  * incident must not use reassignment; project uses only catalog.api + reservation.api;
  * no dependency cycles.

  <b>Pickup pass (#283/#318)</b>:
  PickupPassService + PickupCodes live inside user/ (30 s rotating 6-digit/QR,
  GET /users/me/pickup-pass + POST /admin/pickup-pass/verify).

  <b>Notation</b>
  ()--  provided interface (module's api package)
  ..>   requires / uses (verified against real imports on main 545e334)
  <<event>>  Spring application event (Observer pattern)

  <b>Not drawn as arrows</b> (shared across nearly every module):
  common.error, common.paging, CurrentUser (common.security),
  and the shared Clock bean (common.time, Europe/Bucharest).
  messaging/ (SQS stretch goal) contains only package-info.java.
endlegend

@enduml

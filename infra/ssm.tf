# The app's prod settings as SSM parameters under /campus/ (ADR-003). Each name is exactly the
# environment variable application-prod.yml reads, so the deploy script (W8) can turn
# /campus/* into an env file without a mapping table.
#
# Not here yet: MAIL_FROM (needs a verified SES identity, W9; the app won't start without it,
# so it comes before the first deploy) and the optional ADMIN_EMAIL / ADMIN_PASSWORD.

# Generated by Terraform, so no human ever types or sees them. They end up in the state, which
# is why the state lives only in the encrypted S3 bucket (backend.tf).
resource "random_password" "db" {
  length = 32
  # RDS rejects /, @, " and spaces in the master password; letters and digits are plenty.
  special = false
}

# SecurityConfig uses the UTF-8 bytes of JWT_SECRET as the HS256 key; HS256 needs at least
# 32 bytes and a shorter one fails at startup (doc 23). 64 characters = 64 bytes.
resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_ssm_parameter" "db_password" {
  name  = "/campus/DB_PASSWORD"
  type  = "SecureString"
  value = random_password.db.result
}

resource "aws_ssm_parameter" "jwt_secret" {
  name  = "/campus/JWT_SECRET"
  type  = "SecureString"
  value = random_password.jwt.result
}

resource "aws_ssm_parameter" "db_username" {
  name  = "/campus/DB_USERNAME"
  type  = "String"
  value = "campus"
}

# Only exists while the database exists (db_enabled in rds.tf): the URL needs its host name.
# sslmode=require: the driver refuses a connection that isn't encrypted (its default "prefer"
# would quietly fall back to plain text). RDS's certificate isn't checked, so no CA file needed.
resource "aws_ssm_parameter" "db_url" {
  count = var.db_enabled ? 1 : 0
  name  = "/campus/DB_URL"
  type  = "String"
  value = "jdbc:postgresql://${aws_db_instance.main[0].endpoint}/campus?sslmode=require"
}

resource "aws_ssm_parameter" "aws_region" {
  name  = "/campus/AWS_REGION"
  type  = "String"
  value = var.aws_region
}

resource "aws_ssm_parameter" "photo_bucket" {
  name  = "/campus/PHOTO_BUCKET"
  type  = "String"
  value = aws_s3_bucket.photos.bucket
}

#!/bin/bash
# Runs once, as root, on the server's first boot (compute.tf). Terraform's templatefile() fills in
# the dollar-brace placeholders (region, ECR address, log group) before AWS gets the script; a
# doubled dollar sign is Terraform's escape, so bash's own dollar-brace syntax survives.
# Output: /var/log/cloud-init-output.log on the server (Session Manager shell).
set -euo pipefail

dnf install -y docker
systemctl enable --now docker

# The deploy script. Kept on the server so the W8 deploy.yml can call it again through
# SSM Run Command with a new commit SHA:  campus-deploy <sha>
cat > /usr/local/bin/campus-deploy <<'SCRIPT'
#!/bin/bash
set -euo pipefail
REGION="${region}"
REPO="${repository_url}"

# No tag given (first boot): take the image pushed last. Tags are commit SHAs (storage.tf).
TAG="$${1:-$(aws ecr describe-images --region "$REGION" --repository-name campus-hub \
  --filter tagStatus=TAGGED \
  --query 'sort_by(imageDetails,&imagePushedAt)[-1].imageTags[0]' --output text)}"
# The CLI prints "None" for an empty repository; stop with a clear message instead of pulling ":None".
[ -n "$TAG" ] && [ "$TAG" != None ] || { echo "no tagged image in ECR" >&2; exit 1; }

# The instance role (iam.tf) gives a 12-hour ECR login; no AWS keys anywhere.
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$${REPO%%/*}"
docker pull "$REPO:$TAG"

# ADR-003: every /campus/NAME parameter becomes NAME=value, exactly the variables
# application-prod.yml reads. Readable by root only, because it holds the DB password and JWT secret.
umask 077
aws ssm get-parameters-by-path --region "$REGION" --path /campus --with-decryption \
  --query 'Parameters[].[Name,Value]' --output text \
  | awk -F'\t' '{ sub("^/campus/", "", $1); print $1 "=" $2 }' > /etc/campus.env

# Spring can't start without these; fail here with a clear message instead of a restart loop.
for v in DB_URL DB_USERNAME DB_PASSWORD JWT_SECRET AWS_REGION PHOTO_BUCKET MAIL_FROM; do
  grep -q "^$v=" /etc/campus.env || { echo "missing /campus/$v" >&2; exit 1; }
done

# Replace the running container. A few seconds of downtime; fine for a course project.
# --memory: the JVM sizes its heap from this limit (Dockerfile MaxRAMPercentage=75, ~1.1 GB),
# leaving the rest of the 2 GB for the OS, Docker and the SSM agent.
docker rm -f campus-hub 2>/dev/null || true
docker run -d --name campus-hub --restart unless-stopped \
  --env-file /etc/campus.env -p 8080:8080 --memory 1536m \
  --log-driver awslogs --log-opt awslogs-region="$REGION" --log-opt awslogs-group="${log_group}" \
  "$REPO:$TAG"
# Clean up unused older images so repeated deploys do not fill the 20 GB EBS volume.
docker image prune -f || true
echo "campus-hub $TAG started"
SCRIPT
chmod 755 /usr/local/bin/campus-deploy

/usr/local/bin/campus-deploy
